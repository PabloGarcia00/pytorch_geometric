conv1d_kernel_size: 24
custom_metrics:
- earne_mae_load
- earne_mae_pv
dataset:
  dir: datasets/earne
  format: earne_disagg
  name: earne
  task: graph
  task_type: regression
  transductive: false
earne_data:
  cadence_minutes: 15
  days: 365
  include_id_path: three_macs.csv
  n_user: 10
  raw_data_path: datasets/earne/raw/
gnn:
  act: relu
  batchnorm: false
  dim_inner: 64
  dropout: 0.1
  layer_type: sageconv
  layers_mp: 2
  layers_post_mp: 1
  layers_pre_mp: 0
  stage_type: stack
model:
  graph_pooling: add
  loss_fun: earne_loss
  type: earne_network
num_workers: 4
optim:
  base_lr: 0.0001
  max_epoch: 1
  optimizer: adam
out_dir: results/earne_test_grid_earne_backbone
train:
  batch_size: 32
  ckpt_period: 10
  eval_period: 1
  mode: example
