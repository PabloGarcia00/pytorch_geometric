custom_metrics:
- earne_mae_load
- earne_mae_pv
dataset:
  dir: datasets/earne
  format: earne_loader_new
  name: single_read
  shuffle_split: false
  task: graph
  task_type: regression
  transductive: false
earne_data:
  energy_norm_mode:
    consumption: log1p
    generation: ihs
    load: log1p
    pv: ihs
  filter_ids: []
  filter_zips: []
  graph_mode: static_corr
  k_neighbors: 10
  processed_root: datasets/earne
  weather_features:
  - solar_radiation_avg
  - solar_radiation_max
  - sunshine_duration_min
  - air_temperature
  - soil_temp_5cm
  weather_mode: false
  weather_norm_mode:
    all_features: znorm
  zipcode_coords: ../../exploratory-data-analysis/assets/zipcode_coordinate.csv
gnn:
  act: relu
  att_heads: 4
  batchnorm: false
  clear_feature: false
  dim_inner: 64
  dropout: 0.1
  keep_edge: 1.0
  l2norm: false
  layer_type: gatconv
  layers_mp: 0
  layers_post_mp: 3
  layers_pre_mp: 0
  stage_type: stack
metric_best: loss
model:
  dim_in: 1
  head_name: earne_quantile
  hidden_channels: 64
  loss_fun: earne_loss
  n_quantiles: 3
  node_encoder_name: earne_temporal
  quantiles:
  - 0.1
  - 0.5
  - 0.9
  seq_len: 96
  type: earne_network
num_workers: 4
optim:
  base_lr: 0.001
  max_epoch: 200
  optimizer: adam
  scheduler: warmup_cos
out_dir: results/single_read_grid_exp3
train:
  batch_size: 32
  ckpt_period: 10
  early_stopping:
    enable: true
    mode: min
    monitor: val_loss
    patience: 10
  eval_period: 1
  mode: earne_train
  physics_weight: 0.0
  train_split: 0.6
  val_split: 0.85
  wandb:
    project: earne_single
  warmup:
    enable: true
    epochs: 10
