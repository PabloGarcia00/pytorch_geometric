GraphGymModule(
  (model): EARNeNetwork(
    (encoder): EARNeTemporalEncoder(
      (encoder): Sequential(
        (0): Conv1d(2, 16, kernel_size=(47,), stride=(1,), padding=same)
        (1): ReLU()
        (2): Flatten(start_dim=1, end_dim=-1)
        (3): Linear(in_features=1536, out_features=64, bias=True)
        (4): ReLU()
      )
    )
    (integration): Linear(in_features=75, out_features=64, bias=True)
    (convs): ModuleList(
      (0-1): 2 x GATConv(64, 16, heads=4)
    )
    (norms): ModuleList(
      (0-1): 2 x LayerNorm((64,), eps=1e-05, elementwise_affine=True)
    )
    (head): EARNeQuantileHead(
      (head_load): Linear(in_features=64, out_features=3, bias=True)
      (head_pv): Linear(in_features=64, out_features=3, bias=True)
    )
  )
)
